<?xml version="1.0" encoding="utf-8"?>
<Project>

    <!-- User Configuration -->
    <Import Project="$(MSBuildThisFileDirectory)Directory.Build.props.user" Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.props.user')" />
    <Import Project="Environment.props" Condition="Exists('Environment.props')" />

    <!-- Suppress MSBuild Warnings -->
    <PropertyGroup>
        <ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>None</ResolveAssemblyWarnOrErrorOnTargetArchitectureMismatch>
        <MSBuildWarningsAsMessages>MSB3277</MSBuildWarningsAsMessages>
    </PropertyGroup>

    <!-- Base Settings -->
    <PropertyGroup>
        <TargetFramework>net481</TargetFramework>
        <LangVersion>latest</LangVersion>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <Deterministic>true</Deterministic>
        <IsPackable>false</IsPackable>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>

    <!-- Debug Settings -->
    <PropertyGroup>
        <DebugType>embedded</DebugType>
        <DebugSymbols>true</DebugSymbols>
        <EmbedAllSources>true</EmbedAllSources>
        <PathMap>$(MSBuildProjectDirectory)=.</PathMap>
    </PropertyGroup>

    <!-- Project Metadata -->
    <PropertyGroup>
        <Authors>p1xel8ted</Authors>
        <Company>$(Authors)</Company>
        <Product>$(MSBuildProjectName)</Product>
        <Description>$(MSBuildProjectName)</Description>
        <PackageId>$(MSBuildProjectName)</PackageId>
    </PropertyGroup>

    <!-- Output -->
    <PropertyGroup>
        <OutputPath>$(BepInExPluginsPath)\$(MSBuildProjectName)</OutputPath>
    </PropertyGroup>

    <!-- Version: taken from the top "## X.Y.Z" header in each mod's CHANGELOG.md.
         The changelog is the single source of truth - feeds AssemblyVersion/FileVersion,
         MyPluginInfo.PLUGIN_VERSION (the [BepInPlugin] version), and the zip filename. -->
    <PropertyGroup Condition="Exists('$(MSBuildProjectDirectory)\CHANGELOG.md')">
        <_ChangelogText>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\CHANGELOG.md'))</_ChangelogText>
        <_ChangelogVersion>$([System.Text.RegularExpressions.Regex]::Match($(_ChangelogText), '##\s+(\d+\.\d+\.\d+)').Groups[1].Value)</_ChangelogVersion>
        <Version Condition="'$(_ChangelogVersion)' != ''">$(_ChangelogVersion)</Version>
    </PropertyGroup>
    <PropertyGroup>
        <Version Condition="'$(Version)' == ''">1.0.0</Version>
    </PropertyGroup>

    <!-- Default All References to CopyLocal False -->
    <ItemDefinitionGroup>
        <Reference>
            <Private>False</Private>
        </Reference>
        <ProjectReference>
            <Private>False</Private>
        </ProjectReference>
        <PackageReference>
            <Private>False</Private>
        </PackageReference>
    </ItemDefinitionGroup>

    <!-- BepInEx: reference the game's own DLLs, publicized locally via NStrip, so
         internals like Chainloader.ConfigHideBepInExGOs are reachable and the version
         matches what actually runs. -->
    <ItemGroup>
        <Reference Include="$(StrippedLibs)\BepInEx\BepInEx.dll">
            <HintPath>$(StrippedLibs)\BepInEx\BepInEx.dll</HintPath>
        </Reference>
        <Reference Include="$(StrippedLibs)\BepInEx\0Harmony.dll">
            <HintPath>$(StrippedLibs)\BepInEx\0Harmony.dll</HintPath>
        </Reference>
        <Reference Include="$(StrippedLibs)\BepInEx\MonoMod.Utils.dll">
            <HintPath>$(StrippedLibs)\BepInEx\MonoMod.Utils.dll</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Generates MyPluginInfo (PLUGIN_GUID/NAME/VERSION) from csproj props + Version above -->
    <ItemGroup>
        <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" PrivateAssets="all" />
    </ItemGroup>

    <!-- Game/Unity Assemblies (wildcard from stripped libs) -->
    <ItemGroup>
        <Reference Include="$(StrippedLibs)\*.dll">
            <HintPath>$(StrippedLibs)\%(Filename)%(Extension)</HintPath>
        </Reference>
    </ItemGroup>

    <!-- Shared Source Files (GlobalUsings.cs excluded - each project has its own) -->
    <ItemGroup>
        <Compile Include="..\Shared\Extensions.cs" Link="Extensions.cs" />
        <Compile Include="..\Shared\Utils.cs" Link="Utils.cs" />
        <Compile Include="..\Shared\ConfigurationManagerAttributes.cs" Link="ConfigurationManagerAttributes.cs" />
        <Compile Include="..\Shared\FileLoader.cs" Link="FileLoader.cs" />
        <Compile Include="..\Shared\SpriteUtil.cs" Link="SpriteUtil.cs" />
        <Compile Include="..\Shared\WriteOnce.cs" Link="WriteOnce.cs" />
        <Compile Include="..\Shared\TimestampedLogger.cs" Link="TimestampedLogger.cs" />
        <Compile Include="..\Shared\SettingsChangeLogger.cs" Link="SettingsChangeLogger.cs" />
        <Compile Include="..\Shared\StartupLogger.cs" Link="StartupLogger.cs" />
        <Compile Include="..\Shared\ModLogging.cs" Link="ModLogging.cs" />
    </ItemGroup>

</Project>
